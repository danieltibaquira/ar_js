{
  "name": "islamic-geometry-explorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Parametric explorer for Islamic geometric patterns (Hankin / PIC, Girih, muqarnas) with 2D and 3D rendering.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "three": "^0.171.0",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@types/three": "^0.171.0",
    "@vitest/coverage-v8": "^2.1.8",
    "happy-dom": "^15.11.7",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
